
<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GamePilot AI — Game Event Command Center</title>
<style>
:root{--bg:#080b12;--panel:#101622;--panel2:#151c2a;--line:#263044;--text:#edf2ff;--muted:#8f9bb2;--accent:#7c5cff;--cyan:#20d7ff;--green:#35e39b;--orange:#ffb84d;--red:#ff5c77}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at 80% 0%,#1a1640 0,#080b12 35%);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.app{display:flex;min-height:100vh}
.sidebar{width:245px;background:#0b0f18;border-right:1px solid var(--line);padding:22px 14px;position:fixed;inset:0 auto 0 0}
.logo{font-size:22px;font-weight:900;padding:0 12px 24px}
.logo span{color:var(--cyan)}
.event-mini{background:linear-gradient(135deg,#17162b,#101826);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 4px 20px}
.event-mini b{display:block;margin-bottom:6px}
.event-mini small{color:var(--muted)}
nav button{width:100%;border:0;background:transparent;color:#aeb8cb;text-align:left;padding:11px 13px;border-radius:10px;margin:2px 0;font-weight:650}
nav button.active,nav button:hover{background:#1a2030;color:#fff}
.ico{display:inline-block;width:24px}
.side-bottom{position:absolute;bottom:20px;left:18px;right:18px;color:var(--muted);font-size:12px}
.main{margin-left:245px;width:calc(100% - 245px);padding:28px 34px 60px}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}
.eyebrow{color:var(--cyan);font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.title{font-size:30px;font-weight:900;margin:4px 0}
.sub{color:var(--muted)}
.status{display:flex;gap:10px;align-items:center}
.pill{padding:8px 11px;border:1px solid var(--line);border-radius:99px;background:#101522;color:#b7c2d7;font-size:12px}
.online{color:var(--green)}
.page{display:none}
.page.active{display:block}
.grid{display:grid;gap:16px}
.kpis{grid-template-columns:repeat(4,1fr)}
.cards{grid-template-columns:repeat(3,1fr)}
.two{grid-template-columns:1.3fr .7fr}
.four{grid-template-columns:repeat(4,1fr)}
.card{background:linear-gradient(180deg,#111825,#0e141f);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 10px 30px #0002}
.card h3{margin:0 0 13px;font-size:15px}
.metric{font-size:27px;font-weight:900;margin:5px 0}
.muted{color:var(--muted);font-size:12px}
.accent{color:var(--cyan)}
.green{color:var(--green)}
.orange{color:var(--orange)}
.red{color:var(--red)}
.progress{height:8px;background:#222b3c;border-radius:20px;overflow:hidden;margin:12px 0}
.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--cyan));border-radius:20px}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px}
.section-title{margin:28px 0 14px;font-size:18px}
.btn{border:1px solid var(--line);background:#171e2d;color:#eaf0ff;border-radius:10px;padding:9px 13px;font-weight:700}
.btn.primary{background:linear-gradient(135deg,#7758ff,#4d8cff);border:0}
.btn.green{background:#123126;border-color:#245d48}
.btn.danger{background:#2a141b;border-color:#5a2634}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:left;padding:12px 9px;border-bottom:1px solid #202a3b}
th{color:#78859d;font-size:11px;text-transform:uppercase;letter-spacing:.08em}
.tag{font-size:10px;padding:5px 8px;border-radius:20px;background:#20283a;color:#b9c4da}
.tag.g{background:#103226;color:#5ff0b1}
.tag.o{background:#332716;color:#ffc86d}
.tag.r{background:#351820;color:#ff8094}
.bar{display:flex;height:220px;align-items:end;gap:10px;padding:12px 4px}
.bar div{flex:1;background:linear-gradient(#7c5cff,#20d7ff);border-radius:6px 6px 2px 2px;min-height:8px}
.bar label{display:block;text-align:center;color:var(--muted);font-size:10px;margin-top:6px}
.budget-item{display:grid;grid-template-columns:1fr 100px 85px;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #202a3b}
.budget-item input{width:100%;background:#0b111b;border:1px solid var(--line);color:white;padding:8px;border-radius:8px}
.chat{height:420px;display:flex;flex-direction:column}
.messages{flex:1;overflow:auto;padding:4px}
.msg{max-width:82%;padding:10px 12px;border-radius:12px;margin:8px 0;font-size:13px;line-height:1.45}
.msg.ai{background:#1a2030}
.msg.user{background:#4635a0;margin-left:auto}
.chatbar{display:flex;gap:8px;margin-top:10px}
.chatbar input{flex:1;background:#0b111b;border:1px solid var(--line);color:#fff;padding:11px;border-radius:10px}
.timeline{position:relative;margin-left:8px}
.task{border-left:2px solid var(--accent);padding:0 0 18px 18px;margin-bottom:2px}
.task b{font-size:13px}
.task small{display:block;color:var(--muted);margin-top:3px}
.notice{padding:12px;border:1px solid #33415b;background:#121b2b;border-radius:11px;font-size:12px;color:#bac5d8}
.check{color:var(--green)}
input[type=range]{width:100%}
@media(max-width:900px){
.sidebar{width:70px}
.logo,.event-mini,nav button span,.side-bottom{display:none}
.main{margin-left:70px;width:calc(100% - 70px);padding:20px}
.kpis,.cards,.two,.four{grid-template-columns:1fr}
.top{align-items:flex-start;gap:10px;flex-direction:column}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="logo">GamePilot<span>AI</span></div>
  <div class="event-mini"><b>NL GAME ARENA</b><small>Valorant • 12 okt 2026</small></div>
  <nav>
    <button class="active" data-page="overview">◈ <span>Overzicht</span></button>
    <button data-page="budget">€ <span>Budget & Inkoop</span></button>
    <button data-page="hardware">▣ <span>Hardware & Netwerk</span></button>
    <button data-page="teams">♙ <span>Teams & Spelers</span></button>
    <button data-page="tournament">⚔ <span>Toernooi</span></button>
    <button data-page="schedule">◷ <span>Wedstrijdschema</span></button>
    <button data-page="runbook">☷ <span>Draaiboek & Taken</span></button>
    <button data-page="stream">● <span>Livestream</span></button>
    <button data-page="crew">◉ <span>Crew</span></button>
    <button data-page="ai">✦ <span>AI-assistent</span></button>
  </nav>
  <div class="side-bottom">GamePilot AI v2.4<br>Event Command Center</div>
</aside>

<main class="main">
<header class="top">
 <div>
  <div class="eyebrow">Game event command center</div>
  <div class="title">NL Game Arena</div>
  <div class="sub">Valorant LAN-toernooi • 12 oktober 2026 • Amsterdam</div>
 </div>
 <div class="status">
  <span class="pill"><span class="online">●</span> Alles operationeel</span>
  <button class="btn primary" onclick="notify('Eventplan opgeslagen als concept.')">Opslaan</button>
 </div>
</header>

<section id="overview" class="page active">
 <div class="grid kpis">
  <div class="card"><div class="muted">Totaalbudget</div><div class="metric">€5.000</div><div class="green">€4.820 gepland</div><div class="progress"><i style="width:96.4%"></i></div></div>
  <div class="card"><div class="muted">Teams</div><div class="metric">8 / 8</div><div class="green">32 spelers bevestigd</div></div>
  <div class="card"><div class="muted">Wedstrijden</div><div class="metric">15</div><div class="orange">12 gepland • 3 finale-fase</div></div>
  <div class="card"><div class="muted">Crew</div><div class="metric">12</div><div class="green">9 bevestigd • 3 open</div></div>
 </div>

 <div class="section-title">Eventstatus</div>
 <div class="grid two">
  <div class="card">
   <h3>Projectvoortgang</h3>
   <div class="row"><b>Operationele voorbereiding</b><b class="accent">78%</b></div>
   <div class="progress"><i style="width:78%"></i></div>
   <div class="grid four">
    <div><div class="metric green">✓</div><div class="muted">Locatie</div></div>
    <div><div class="metric green">✓</div><div class="muted">Teams</div></div>
    <div><div class="metric green">✓</div><div class="muted">PC's</div></div>
    <div><div class="metric orange">!</div><div class="muted">Livestream</div></div>
   </div>
  </div>
  <div class="card">
   <h3>AI-alerts</h3>
   <div class="notice"><b class="orange">1 aandachtspunt</b><br>De reserve-switch is nog niet toegewezen aan een crewlid.</div>
   <div style="height:8px"></div>
   <div class="notice"><b class="green">Planning klopt</b><br>Er zit 20 minuten buffer tussen halve finale en finale.</div>
  </div>
 </div>

 <div class="section-title">Budgetverdeling</div>
 <div class="grid two">
  <div class="card">
   <div class="bar">
    <div style="height:82%"><label>Hardware<br>€1.620</label></div>
    <div style="height:54%"><label>Locatie<br>€1.050</label></div>
    <div style="height:36%"><label>Netwerk<br>€700</label></div>
    <div style="height:30%"><label>Stream<br>€580</label></div>
    <div style="height:25%"><label>Prijzen<br>€500</label></div>
    <div style="height:19%"><label>Crew<br>€370</label></div>
   </div>
  </div>
  <div class="card">
   <h3>Vandaag</h3>
   <div class="timeline">
    <div class="task"><b>09:00 — Teamcheck</b><small>Alle teamcaptains bevestigen roster.</small></div>
    <div class="task"><b>13:00 — Netwerktest</b><small>Latency, DHCP en switch-failover.</small></div>
    <div class="task"><b>17:00 — Streamtest</b><small>OBS-scenes + audio + scoreboard.</small></div>
   </div>
  </div>
 </div>
</section>

<section id="budget" class="page">
 <div class="section-title">Budget & Inkoop</div>
 <div class="grid two">
  <div class="card">
   <h3>Begroting</h3>
   <div id="budgetList"></div>
   <div class="row" style="padding-top:15px"><b>Totaal</b><b id="budgetTotal">€4.820</b></div>
   <div class="progress"><i id="budgetBar" style="width:96.4%"></i></div>
   <div class="muted">Maximaal €5.000 • reserve wordt automatisch berekend.</div>
  </div>
  <div class="card">
   <h3>AI-inkoopadvies</h3>
   <div class="notice">Voor 8 teams adviseert GamePilot <b>10 gaming-pc's</b>: 8 actief + 2 reserve. Hierdoor kan een defecte pc direct worden vervangen.</div><br>
   <div class="notice">Netwerk: 1 managed switch + 1 reserve-switch, minimaal 1 Gbit/s per poort.</div><br>
   <button class="btn primary" onclick="notify('Inkoopadvies toegevoegd aan het eventplan.')">Gebruik advies</button>
  </div>
 </div>
</section>

<section id="hardware" class="page">
 <div class="section-title">Hardware & Netwerk</div>
 <div class="grid cards">
  <div class="card"><h3>Gaming-pc's</h3><div class="metric">10</div><div class="muted">8 actief + 2 reserve</div><div class="progress"><i style="width:90%"></i></div><p>Doel: stabiele gameplay op 144+ FPS.</p></div>
  <div class="card"><h3>Netwerk</h3><div class="metric">1 Gbit/s</div><div class="muted">Per spelerspoort</div><p>Managed switch, VLAN voor spelers en aparte verbinding voor stream.</p></div>
  <div class="card"><h3>Internet</h3><div class="metric">500 Mbps</div><div class="muted">Aanbevolen verbinding</div><p>Gebruik bekabeld internet en test de upload vóór het evenement.</p></div>
 </div>
 <div class="section-title">Technische checklist</div>
 <div class="card">
  <p><label><input type="checkbox"> Alle pc's getest en bijgewerkt</label></p>
  <p><label><input type="checkbox"> Reserve-pc's klaar voor gebruik</label></p>
  <p><label><input type="checkbox"> Netwerkkabels en reservekabels gecontroleerd</label></p>
  <p><label><input type="checkbox"> VLAN's en DHCP gecontroleerd</label></p>
  <p><label><input type="checkbox"> Internetverbinding en stream-upload getest</label></p>
  <p><label><input type="checkbox"> Reserve-switch getest</label></p>
 </div>
</section>

<section id="teams" class="page">
 <div class="section-title">Teams & Spelers</div>
 <div class="card">
  <div class="row"><h3>Deelnemende teams</h3><button class="btn primary" onclick="notify('Teamregistratie is een demo in deze versie.')">+ Team toevoegen</button></div>
  <table>
   <thead><tr><th>Seed</th><th>Team</th><th>Captain</th><th>Roster</th><th>Status</th><th>Seed</th></tr></thead>
   <tbody>
    <tr><td>#1</td><td>LowLand Lions</td><td>Leo</td><td>Leo, Max, Finn, Jens, Sem</td><td><span class="tag g">Bevestigd</span></td><td>#1</td></tr>
    <tr><td>#2</td><td>Pixel Raiders</td><td>Nova</td><td>Nova, Kai, Luca, Bo, Dex</td><td><span class="tag g">Bevestigd</span></td><td>#2</td></tr>
    <tr><td>#3</td><td>Delta Five</td><td>Rex</td><td>Rex, Jay, Mo, Alex, Rio</td><td><span class="tag g">Bevestigd</span></td><td>#3</td></tr>
    <tr><td>#4</td><td>Orange Protocol</td><td>Blaze</td><td>Blaze, Ace, Wolf, Zen, Ash</td><td><span class="tag g">Bevestigd</span></td><td>#4</td></tr>
    <tr><td>#5</td><td>North Wolves</td><td>Frost</td><td>Frost, Finn, Kai, Neo, Lux</td><td><span class="tag g">Bevestigd</span></td><td>#5</td></tr>
    <tr><td>#6</td><td>Syntax</td><td>Loop</td><td>Loop, Stack, Null, Ping, Core</td><td><span class="tag o">Check 1 speler</span></td><td>#6</td></tr>
    <tr><td>#7</td><td>Quantum</td><td>Qbit</td><td>Qbit, Ion, Fluxx, Ray, Neo</td><td><span class="tag g">Bevestigd</span></td><td>#7</td></tr>
    <tr><td>#8</td><td>Stormbyte</td><td>Storm</td><td>Storm, Volt, Ash, NovaX, Vio</td><td><span class="tag g">Bevestigd</span></td><td>#8</td></tr>
   </tbody>
  </table>
 </div>
</section>

<section id="tournament" class="page">
 <div class="section-title">Toernooi-configuratie</div>
 <div class="grid two">
  <div class="card">
   <h3>Format</h3>
   <div class="notice"><b>8 teams → kwartfinales → halve finales → finale</b><br>Best-of-1 kwartfinales • Best-of-3 halve finales • Best-of-5 finale</div><br>
   <label class="muted">Map pool</label><p>Haven • Ascent • Bind • Lotus • Sunset</p>
   <label class="muted">Puntensysteem</label><p>Win = 3 punten • verlies = 0</p>
   <button class="btn primary" onclick="notify('Bracket gegenereerd op basis van seeds 1–8.')">Genereer bracket</button>
  </div>
  <div class="card">
   <h3>Bracket</h3>
   <p>QF1 <b>LowLand Lions</b> vs Stormbyte</p>
   <p>QF2 <b>Pixel Raiders</b> vs Quantum</p>
   <p>QF3 <b>Delta Five</b> vs Syntax</p>
   <p>QF4 <b>Orange Protocol</b> vs North Wolves</p>
   <div class="notice">AI-seeding gebruikt teamranking en eerdere resultaten.</div>
  </div>
 </div>
</section>

<section id="schedule" class="page">
 <div class="section-title">Wedstrijdschema</div>
 <div class="card">
  <table>
   <thead><tr><th>Tijd</th><th>Match</th><th>Stage</th><th>PC's</th><th>Stream</th></tr></thead>
   <tbody>
    <tr><td>10:00</td><td>LowLand Lions vs Stormbyte</td><td>QF1 • BO1</td><td>A1–A5</td><td>✓</td></tr>
    <tr><td>10:50</td><td>Pixel Raiders vs Quantum</td><td>QF2 • BO1</td><td>A1–A5</td><td>✓</td></tr>
    <tr><td>11:40</td><td>Delta Five vs Syntax</td><td>QF3 • BO1</td><td>A1–A5</td><td>✓</td></tr>
    <tr><td>12:30</td><td>Orange Protocol vs North Wolves</td><td>QF4 • BO1</td><td>A1–A5</td><td>✓</td></tr>
    <tr><td>14:00</td><td>Halve finale 1</td><td>SF1 • BO3</td><td>A1–A5</td><td>✓</td></tr>
    <tr><td>16:00</td><td>Halve finale 2</td><td>SF2 • BO3</td><td>A1–A5</td><td>✓</td></tr>
    <tr><td>18:30</td><td>Grand Final</td><td>BO5</td><td>A1–A5</td><td>LIVE</td></tr>
   </tbody>
  </table>
 </div>
</section>

<section id="runbook" class="page">
 <div class="section-title">Draaiboek & Taken</div>
 <div class="grid two">
  <div class="card">
   <h3>Operationeel draaiboek — 12 oktober</h3>
   <div class="timeline">
    <div class="task"><b>07:30 — Crew call</b><small>Badge, portofoon, rolverdeling.</small></div>
    <div class="task"><b>08:00 — Hardware boot</b><small>PC imaging, drivers, game update, randapparatuur.</small></div>
    <div class="task"><b>08:45 — Network lock</b><small>VLAN's controleren en latencytest.</small></div>
    <div class="task"><b>09:15 — Team check-in</b><small>Roster + accounts + randapparatuur.</small></div>
    <div class="task"><b>09:45 — Opening</b><small>Host, regels en bracket uitleg.</small></div>
    <div class="task"><b>10:00 — Eerste matches</b><small>Admin volgt score en incidenten.</small></div>
    <div class="task"><b>18:30 — Finale</b><small>Extra camera, analyst en volledige stream crew.</small></div>
    <div class="task"><b>21:00 — Afbouw</b><small>Apparatuur tellen, data back-up, locatie opleveren.</small></div>
   </div>
  </div>
  <div class="card">
   <h3>Open taken</h3>
   <p>☐ Reserve-switch aan <b>Sam</b> koppelen</p>
   <p>☐ 1 Syntax-speler bevestigen</p>
   <p>☐ Sponsorlogo's in stream overlay</p>
   <p>☐ Prijzengeld / prijzen klaarzetten</p>
   <p>☐ Finale-camera testen</p>
   <button class="btn green" onclick="completeTasks()">Alle taken controleren</button>
  </div>
 </div>
</section>

<section id="stream" class="page">
 <div class="section-title">Livestream</div>
 <div class="grid cards">
  <div class="card">
   <h3>Stream status</h3>
   <div class="metric green">● READY</div>
   <div class="muted">YouTube/Twitch output • 1080p60</div><br>
   <div class="notice">Encoder: OBS Studio<br>Bitrate: 8.000 kbps<br>Audio: 48 kHz<br>Scenes: Starting / Match / Break / Final / Winners</div>
  </div>
  <div class="card">
   <h3>Productiecrew</h3>
   <p>Host — Mila</p><p>Observer — Dex</p><p>Camera — Noor</p><p>Producer — Sam</p><p>Scoreboard — Jay</p>
  </div>
  <div class="card">
   <h3>Stream checklist</h3>
   <p class="check">✓ Microfoon getest</p>
   <p class="check">✓ Game capture</p>
   <p class="check">✓ Score overlay</p>
   <p class="check">✓ Sponsor overlay</p>
   <p class="orange">◷ Finale replay testen</p>
  </div>
 </div>
</section>

<section id="crew" class="page">
 <div class="section-title">Crew & Rollen</div>
 <div class="card">
  <table>
   <thead><tr><th>Naam</th><th>Rol</th><th>Verantwoordelijkheid</th><th>Status</th></tr></thead>
   <tbody>
    <tr><td>Sam</td><td>Event lead</td><td>Planning, budget, escalaties</td><td><span class="tag g">Actief</span></td></tr>
    <tr><td>Mila</td><td>Host</td><td>Opening, interviews, finale</td><td><span class="tag g">Actief</span></td></tr>
    <tr><td>Dex</td><td>Observer</td><td>In-game camera & broadcast</td><td><span class="tag g">Actief</span></td></tr>
    <tr><td>Noor</td><td>Camera</td><td>POV, stage shots, interviews</td><td><span class="tag g">Actief</span></td></tr>
    <tr><td>Jay</td><td>Score admin</td><td>Scores, bracket, match reports</td><td><span class="tag g">Actief</span></td></tr>
    <tr><td>Alex</td><td>Tech</td><td>PC's, drivers, randapparatuur</td><td><span class="tag g">Actief</span></td></tr>
    <tr><td>Ravi</td><td>Network</td><td>Switch, VLAN, internet</td><td><span class="tag g">Actief</span></td></tr>
    <tr><td>3 open</td><td>Support</td><td>Spelerbegeleiding, setup, afbouw</td><td><span class="tag o">Werving</span></td></tr>
   </tbody>
  </table>
 </div>
</section>

<section id="ai" class="page">
 <div class="section-title">GamePilot AI-assistent</div>
 <div class="grid two">
  <div class="card chat">
   <h3>Event Copilot</h3>
   <div id="messages" class="messages">
    <div class="msg ai">Hoi! Ik ben GamePilot AI. Ik kan je helpen met budget, hardware, netwerk, teams, planning, livestream en het draaiboek. Probeer bijvoorbeeld: <b>“Maak een plan voor een netwerkstoring.”</b></div>
   </div>
   <div class="chatbar">
    <input id="chatInput" placeholder="Vraag iets over het evenement..." onkeydown="if(event.key==='Enter')askAI()">
    <button class="btn primary" onclick="askAI()">Stuur</button>
   </div>
  </div>
  <div class="card">
   <h3>Snelle acties</h3>
   <button class="btn" style="width:100%;margin-bottom:8px" onclick="quick('Controleer of het budget onder €5.000 blijft.')">Budget controleren</button>
   <button class="btn" style="width:100%;margin-bottom:8px" onclick="quick('Maak een netwerk-storingsplan.')">Storingsplan</button>
   <button class="btn" style="width:100%;margin-bottom:8px" onclick="quick('Maak een checklist voor de finale.')">Finale-checklist</button>
   <button class="btn" style="width:100%" onclick="quick('Welke taken hebben nu de hoogste prioriteit?')">Prioriteiten</button>
  </div>
 </div>
</section>
</main>
</div>

<div id="toast" style="position:fixed;right:25px;bottom:25px;background:#171f2e;border:1px solid #35415a;padding:12px 16px;border-radius:10px;display:none;box-shadow:0 10px 35px #0008"></div>

<script>
const budget=[
 ["Gaming-pc's + randapparatuur",1620],
 ["Locatie + stroom",1050],
 ["Netwerk + bekabeling",700],
 ["Livestream & productie",580],
 ["Prijzen & trofee",500],
 ["Crew & catering",370]
];

function euro(n){
 return '€'+n.toLocaleString('nl-NL');
}

function renderBudget(){
 const el=document.getElementById('budgetList');
 if(!el)return;

 el.innerHTML=budget.map((b,i)=>`
  <div class="budget-item">
   <span>${b[0]}</span>
   <input type="number" min="0" value="${b[1]}"
    aria-label="Bedrag voor ${b[0]}"
    onchange="budget[${i}][1]=Math.max(0,Number(this.value)||0);renderBudget()">
   <b>${euro(b[1])}</b>
  </div>
 `).join('');

 const total=budget.reduce((s,b)=>s+b[1],0);
 document.getElementById('budgetTotal').textContent=euro(total);
 document.getElementById('budgetBar').style.width=Math.min(total/5000*100,100)+'%';
 document.getElementById('budgetBar').style.background=total>5000?'var(--red)':'';
}

renderBudget();

document.querySelectorAll('nav button').forEach(btn=>{
 btn.addEventListener('click',()=>{
  document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById(btn.dataset.page).classList.add('active');
 });
});

function notify(message){
 const toast=document.getElementById('toast');
 toast.textContent=message;
 toast.style.display='block';
 clearTimeout(window.tt);
 window.tt=setTimeout(()=>toast.style.display='none',2600);
}

function completeTasks(){
 document.querySelectorAll('#runbook p').forEach(p=>{
  p.innerHTML=p.innerHTML.replace('☐','✓');
 });
 notify('Taken gemarkeerd als gecontroleerd.');
}

function addMsg(message,who){
 const messages=document.getElementById('messages');
 const div=document.createElement('div');
 div.className='msg '+who;
 div.textContent=message;
 messages.appendChild(div);
 messages.scrollTop=messages.scrollHeight;
}

function quick(message){
 document.getElementById('chatInput').value=message;
 askAI();
}

function askAI(){
 const input=document.getElementById('chatInput');
 const question=input.value.trim();
 if(!question)return;

 addMsg(question,'user');
 input.value='';

 setTimeout(()=>{
  let answer='Op basis van het huidige eventplan raad ik aan om dit als eerstvolgende actie in te plannen.';
  const q=question.toLowerCase();

  if(q.includes('budget')){
   const total=budget.reduce((sum,item)=>sum+item[1],0);
   answer=`Het huidige plan staat op ${euro(total)} van €5.000. De resterende ruimte is ${euro(5000-total)}. De grootste posten zijn hardware, locatie en netwerk.`;
  }else if(q.includes('netwerk')||q.includes('storing')){
   answer='Storingsplan: 1) bepaal welke spelers zijn getroffen, 2) controleer switch-link en VLAN, 3) gebruik indien nodig de reserve-switch, 4) test de verbindingen, 5) laat de event lead de hervatting bevestigen.';
  }else if(q.includes('finale')){
   answer='Finale-checklist: stream testen, observer verbinden, score-overlay controleren, extra camera klaarzetten, BO5-format bevestigen, buffer bewaken en prijzen klaarzetten.';
  }else if(q.includes('prioriteit')){
   answer='Prioriteit: (1) reserve-switch toewijzen, (2) Syntax-roster bevestigen, (3) finale-streamtest, (4) sponsoroverlays controleren, (5) prijzen klaarzetten.';
  }else if(q.includes('hardware')||q.includes('pc')){
   answer='Voor 8 teams zijn 8 actieve gaming-pc’s plus 2 reserve-pc’s gepland. Controleer game-updates, drivers, randapparatuur en prestaties vóór de eerste match.';
  }else if(q.includes('planning')||q.includes('schema')){
   answer='Het schema begint met de kwartfinales om 10:00. Daarna volgen de halve finales om 14:00 en 16:00 en de finale om 18:30. Houd buffer vrij voor uitloop.';
  }else if(q.includes('crew')||q.includes('personeel')){
   answer='De crewrollen zijn event lead, host, observer, camera, score admin, tech en netwerk. Wijs de open supportrollen toe vóór de opbouw begint.';
  }

  addMsg(answer,'ai');
 },250);
}
</script>
</body>
</html>
